@UniShareProject.API_HostAddress = http://localhost:5100

### Variables for testing
@testEmail = test.user@principia.edu
@testPassword = Th1s1satest!
@testEmail2 = another.user@principia.edu
@testPassword2 = AnotherPassword123

# NOTE: Replace this with the actual token from your login response
@authToken = eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..wmPNQu3_JZlj8yL-XJaO1Is0zmrWkxUHKH0wWZCmtAw

# NOTE: Replace this with the actual token from second user login
@authToken2 = 

### ---------------------------------------------------------------------------
# TESTING FLOW - EXECUTE IN CHRONOLOGICAL ORDER
### ---------------------------------------------------------------------------

### STEP 1: Register first user (seller)
POST {{UniShareProject.API_HostAddress}}/api/auth/register
Content-Type: application/json

{
  "firstName": "Test",
  "lastName": "User",
  "email": "{{testEmail}}",
  "password": "{{testPassword}}"
}

### STEP 2: Login with first user (COPY THE TOKEN TO @authToken)
POST {{UniShareProject.API_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "{{testEmail}}",
  "password": "{{testPassword}}"
}

### STEP 3: Register second user (buyer)
POST {{UniShareProject.API_HostAddress}}/api/auth/register
Content-Type: application/json

{
  "firstName": "Another",
  "lastName": "User", 
  "email": "{{testEmail2}}",
  "password": "{{testPassword2}}"
}

### STEP 4: Login with second user (COPY THE TOKEN TO @authToken2)
POST {{UniShareProject.API_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "{{testEmail2}}",
  "password": "{{testPassword2}}"
}

### STEP 5: Create first item (as first user - seller)
POST {{UniShareProject.API_HostAddress}}/api/items
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "title": "Calculus Textbook",
  "description": "Like new condition calculus textbook for Math 151. No highlighting or writing inside.",
  "categoryId": 1,
  "price": 75.00,
  "conditionId": 1
}

### STEP 6: Create second item (as first user - seller)
POST {{UniShareProject.API_HostAddress}}/api/items
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "title": "MacBook Pro 2019",
  "description": "Used MacBook Pro in good condition. Some minor scratches on the back.",
  "categoryId": 2,
  "price": 899.99,
  "conditionId": 2
}

### STEP 7: Add images to first item (as seller - item owner)
POST {{UniShareProject.API_HostAddress}}/api/items/1/images
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "imageUrls": [
    "https://picsum.photos/800/600?random=1",
    "https://picsum.photos/800/600?random=2"
  ]
}

### STEP 8: Add more images to first item (as seller)
POST {{UniShareProject.API_HostAddress}}/api/items/1/images
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "imageUrls": [
    "https://picsum.photos/800/600?random=3"
  ]
}

### STEP 9: Add images to second item (as seller) - Test 4 image limit
POST {{UniShareProject.API_HostAddress}}/api/items/2/images
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "imageUrls": [
    "https://picsum.photos/800/600?random=4",
    "https://picsum.photos/800/600?random=5",
    "https://picsum.photos/800/600?random=6",
    "https://picsum.photos/800/600?random=7"
  ]
}

### STEP 10: Search all items (public access - no auth needed)
GET {{UniShareProject.API_HostAddress}}/api/items

### STEP 11: Search items with filters
GET {{UniShareProject.API_HostAddress}}/api/items?categoryId=1&statusId=1&q=calculus

### STEP 12: Get specific item by ID (public access)
GET {{UniShareProject.API_HostAddress}}/api/items/1

### STEP 13: Request purchase of first item (as second user - buyer)
POST {{UniShareProject.API_HostAddress}}/api/items/1/request-purchase
Authorization: Bearer {{authToken2}}

### STEP 14: Verify item status changed to Pending
GET {{UniShareProject.API_HostAddress}}/api/items/1

### STEP 15: Mark item as sold (as original seller)
POST {{UniShareProject.API_HostAddress}}/api/items/1/mark-sold
Authorization: Bearer {{authToken}}

### STEP 16: Verify item status changed to Sold
GET {{UniShareProject.API_HostAddress}}/api/items/1

### STEP 17: Request purchase of second item (as second user - buyer)
POST {{UniShareProject.API_HostAddress}}/api/items/2/request-purchase
Authorization: Bearer {{authToken2}}

### STEP 18: Update item status manually (as seller/admin)
PATCH {{UniShareProject.API_HostAddress}}/api/items/2/status?statusId=4
Authorization: Bearer {{authToken}}

### STEP 19: Get current user profile (as first user)
GET {{UniShareProject.API_HostAddress}}/api/users/me
Authorization: Bearer {{authToken}}

### STEP 20: Update current user profile (as first user)
PUT {{UniShareProject.API_HostAddress}}/api/users/me
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "phone": "+1-555-123-4567",
  "house": "Johnson Hall",
  "profileImageUrl": "https://picsum.photos/200/200?random=300"
}

### STEP 21: Verify profile was updated
GET {{UniShareProject.API_HostAddress}}/api/users/me
Authorization: Bearer {{authToken}}

### STEP 22: Get current user profile (as second user)
GET {{UniShareProject.API_HostAddress}}/api/users/me
Authorization: Bearer {{authToken2}}

### STEP 23: Update second user profile
PUT {{UniShareProject.API_HostAddress}}/api/users/me
Content-Type: application/json
Authorization: Bearer {{authToken2}}

{
  "phone": "+1-555-987-6543",
  "house": "Anderson Hall"
}

### ---------------------------------------------------------------------------
# ERROR SCENARIOS TESTING
### ---------------------------------------------------------------------------

### ERROR 1: Register with invalid email domain (should fail)
POST {{UniShareProject.API_HostAddress}}/api/auth/register
Content-Type: application/json

{
  "firstName": "Invalid",
  "lastName": "User",
  "email": "invalid@gmail.com",
  "password": "TestPassword123"
}

### ERROR 2: Register duplicate email (should fail)
POST {{UniShareProject.API_HostAddress}}/api/auth/register
Content-Type: application/json

{
  "firstName": "Duplicate",
  "lastName": "User",
  "email": "{{testEmail}}",
  "password": "DifferentPassword123"
}

### ERROR 3: Login with wrong password (should fail)
POST {{UniShareProject.API_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "{{testEmail}}",
  "password": "WrongPassword"
}

### ERROR 4: Create item without authentication (should fail with 401)
POST {{UniShareProject.API_HostAddress}}/api/items
Content-Type: application/json

{
  "title": "Unauthorized Item",
  "description": "This should fail without proper auth",
  "categoryId": 1,
  "price": 50.00,
  "conditionId": 1
}

### ERROR 5: Create item with invalid data (should fail with validation)
POST {{UniShareProject.API_HostAddress}}/api/items
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "title": "",
  "description": "Invalid",
  "price": -10.00,
  "conditionId": 999
}

### ERROR 6: Add images without authentication (should fail with 401)
POST {{UniShareProject.API_HostAddress}}/api/items/1/images
Content-Type: application/json

{
  "imageUrls": ["https://picsum.photos/800/600?random=100"]
}

### ERROR 7: Add images as non-owner (should fail with 403)
POST {{UniShareProject.API_HostAddress}}/api/items/1/images
Content-Type: application/json
Authorization: Bearer {{authToken2}}

{
  "imageUrls": ["https://picsum.photos/800/600?random=101"]
}

### ERROR 8: Add invalid image URLs (should fail with validation)
POST {{UniShareProject.API_HostAddress}}/api/items/1/images
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "imageUrls": [
    "not-a-valid-url",
    "ftp://invalid-scheme.com/image.jpg",
    ""
  ]
}

### ERROR 9: Add too many images (should fail with 409)
# Try to add more images to item 1 which already has 3, adding 2 more = 5 total (exceeds limit)
POST {{UniShareProject.API_HostAddress}}/api/items/1/images
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "imageUrls": [
    "https://picsum.photos/800/600?random=102",
    "https://picsum.photos/800/600?random=103"
  ]
}

### ERROR 10: Request purchase without authentication (should fail with 401)
POST {{UniShareProject.API_HostAddress}}/api/items/2/request-purchase

### ERROR 11: Request purchase of non-existent item (should fail with 404)
POST {{UniShareProject.API_HostAddress}}/api/items/999999/request-purchase
Authorization: Bearer {{authToken2}}

### ERROR 12: Request purchase of already pending/sold item (should fail with 409)
POST {{UniShareProject.API_HostAddress}}/api/items/1/request-purchase
Authorization: Bearer {{authToken2}}

### ERROR 13: Mark sold without authentication (should fail with 401)
POST {{UniShareProject.API_HostAddress}}/api/items/2/mark-sold

### ERROR 14: Mark sold as non-owner (should fail with 403)
POST {{UniShareProject.API_HostAddress}}/api/items/2/mark-sold
Authorization: Bearer {{authToken2}}

### ERROR 15: Mark sold when not in Pending status (should fail with 409)
# Create a new item and try to mark it sold while still Active
POST {{UniShareProject.API_HostAddress}}/api/items
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "title": "Test Item for Status Error",
  "description": "This item will be used to test marking sold while Active",
  "categoryId": 5,
  "price": 25.00,
  "conditionId": 3
}

### ERROR 16: Try to mark the new item as sold while it's still Active (should fail)
POST {{UniShareProject.API_HostAddress}}/api/items/3/mark-sold
Authorization: Bearer {{authToken}}

### ERROR 17: Mark non-existent item as sold (should fail with 404)
POST {{UniShareProject.API_HostAddress}}/api/items/999999/mark-sold
Authorization: Bearer {{authToken}}

### ERROR 18: Update status without authentication (should fail with 401)
PATCH {{UniShareProject.API_HostAddress}}/api/items/1/status?statusId=3

### ERROR 19: Get non-existent item (should fail with 404)
GET {{UniShareProject.API_HostAddress}}/api/items/999999

### ERROR 20: Add empty image URLs array (should fail with validation)
POST {{UniShareProject.API_HostAddress}}/api/items/1/images
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "imageUrls": []
}

### ERROR 21: Add null image URLs (should fail with validation)
POST {{UniShareProject.API_HostAddress}}/api/items/1/images
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "imageUrls": null
}

### ERROR 22: Get user profile without authentication (should fail with 401)
GET {{UniShareProject.API_HostAddress}}/api/users/me

### ERROR 23: Update user profile without authentication (should fail with 401)
PUT {{UniShareProject.API_HostAddress}}/api/users/me
Content-Type: application/json

{
  "phone": "+1-555-000-0000",
  "house": "Test Hall"
}

### ERROR 24: Update user profile with invalid data (should fail with validation)
PUT {{UniShareProject.API_HostAddress}}/api/users/me
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "phone": "this-is-way-too-long-for-a-phone-number-field-that-should-only-be-20-characters-max",
  "house": "this-house-name-is-way-too-long-for-the-field-that-should-only-be-50-characters-maximum-allowed",
  "profileImageUrl": "not-a-valid-url"
}

### ERROR 25: Update user profile with null request body (should fail)
PUT {{UniShareProject.API_HostAddress}}/api/users/me
Content-Type: application/json
Authorization: Bearer {{authToken}}

### Try to add one more image (should fail - exceeds limit)
POST {{UniShareProject.API_HostAddress}}/api/items/4/images
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "imageUrls": [
    "https://picsum.photos/800/600?random=204"
  ]
}

### ---------------------------------------------------------------------------
# USER PROFILE MANAGEMENT TESTING
### ---------------------------------------------------------------------------

### Get profile without any updates (baseline)
GET {{UniShareProject.API_HostAddress}}/api/users/me
Authorization: Bearer {{authToken}}

### Update profile with all fields
PUT {{UniShareProject.API_HostAddress}}/api/users/me
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "phone": "+1-555-111-2222",
  "house": "Davis Hall",
  "profileImageUrl": "https://picsum.photos/200/200?random=400"
}

### Verify full profile update
GET {{UniShareProject.API_HostAddress}}/api/users/me
Authorization: Bearer {{authToken}}

### Update profile with partial fields (only phone)
PUT {{UniShareProject.API_HostAddress}}/api/users/me
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "phone": "+1-555-333-4444"
}

### Update profile with partial fields (only house)
PUT {{UniShareProject.API_HostAddress}}/api/users/me
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "house": "Miller Hall"
}

### Update profile with partial fields (only profile image)
PUT {{UniShareProject.API_HostAddress}}/api/users/me
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "profileImageUrl": "https://picsum.photos/200/200?random=401"
}

### Clear profile fields by setting to null/empty
PUT {{UniShareProject.API_HostAddress}}/api/users/me
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "phone": null,
  "house": null,
  "profileImageUrl": null
}

### Verify profile fields were cleared
GET {{UniShareProject.API_HostAddress}}/api/users/me
Authorization: Bearer {{authToken}}
