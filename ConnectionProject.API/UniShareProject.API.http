### ========================================================================
### SECTION 2: AUTHENTICATION ENDPOINTS
### ========================================================================

### AUTH-01: Register First User (Seller)
# @name registerUser1
POST {{UniShareProject.API_HostAddress}}/api/auth/register
Content-Type: application/json

{
  "firstName": "Test",
  "lastName": "User",
  "email": "{{testEmail}}",
  "password": "{{testPassword}}"
}

###

### AUTH-02: Login First User (COPY TOKEN TO @authToken)
# @name loginUser1
POST {{UniShareProject.API_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "{{testEmail}}",
  "password": "{{testPassword}}"
}

###

### AUTH-03: Register Second User (Buyer)
# @name registerUser2
POST {{UniShareProject.API_HostAddress}}/api/auth/register
Content-Type: application/json

{
  "firstName": "Another",
  "lastName": "User", 
  "email": "{{testEmail2}}",
  "password": "{{testPassword2}}"
}

###

### AUTH-04: Login Second User (COPY TOKEN TO @authToken2)
# @name loginUser2
POST {{UniShareProject.API_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "{{testEmail2}}",
  "password": "{{testPassword2}}"
}

###

### AUTH-05: Register Admin User
# @name registerAdmin
POST {{UniShareProject.API_HostAddress}}/api/auth/register
Content-Type: application/json

{
  "firstName": "Admin",
  "lastName": "User",
  "email": "{{adminEmail}}",
  "password": "{{adminPassword}}"
}

###

### AUTH-06: Login Admin User (COPY TOKEN TO @adminToken)
# @name loginAdmin
POST {{UniShareProject.API_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "{{adminEmail}}",
  "password": "{{adminPassword}}"
}

###

